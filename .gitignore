# dependencies
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# IDE e cache Gradle
.gradle/
.idea/

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# screenshot da trasformare in news (skill news-da-screenshot)
news-inbox/*
!news-inbox/.gitkeep

# Python
__pycache__/

# config locale della preview
.claude/launch.json

# wrangler pages dev (prova locale della PWA)
.wrangler/

# chiave service account Firebase (FCM v1): si carica su EAS, non va nel repository
*firebase-adminsdk*.json
