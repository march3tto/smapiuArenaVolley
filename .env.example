# Copiare in .env (sviluppo) e impostare le stesse variabili negli ambienti EAS per le build (eas env:create).
# Solo valori pubblici: tutto ciò che inizia con EXPO_PUBLIC_ finisce nell'app.

# Supabase (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://<progetto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Accessi social: lasciare commentati finché il provider non è configurato (oggi l'app offre solo email).
# Vedi docs/DA_FARE.md. Con Google o Facebook su iOS va attivato anche Apple (App Store 4.8).
# EXPO_PUBLIC_LOGIN_APPLE=1
# EXPO_PUBLIC_LOGIN_FACEBOOK=1
# Google Sign-In (Google Cloud > Credenziali > ID client OAuth): impostare l'ID web attiva il pulsante. Valori pubblici.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<id>.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<id>.apps.googleusercontent.com

# Facoltativo: partita in diretta dimostrativa (1 = accesa)
# EXPO_PUBLIC_DEMO_LIVE=1

# ---------------------------------------------------------------------------------------------
# NON vanno qui: sono secrets delle Edge Functions (supabase secrets set ..., vedi docs/gdpr/README.md)
#   APPLE_TEAM_ID=
#   APPLE_KEY_ID=
#   APPLE_CLIENT_ID=it.arenavolleyteam.app
#   APPLE_PRIVATE_KEY=          contenuto del file .p8 (il file non va nel repository)
#   FACEBOOK_APP_SECRET=
#   NOTIFICHE_SEGRETO=
#   GROQ_API_KEY=
